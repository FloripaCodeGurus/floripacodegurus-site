# Staging Environment Variables Template
# Copy to .env.staging (on the server or locally) and set real values.
# Do not commit .env.staging with real secrets.

# Django
SECRET_KEY=your-staging-secret-key-here
DEBUG=True
ALLOWED_HOSTS=134.209.73.13,localhost,127.0.0.1,floripacodegurus.com

# Database (PostgreSQL in docker-compose-staging)
POSTGRES_DB=floripacodegurus_staging
POSTGRES_USER=floripacodegurus_staging_user
POSTGRES_PASSWORD=your-staging-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional: superuser for initial setup
# USER_NAME=Admin Staging
# USER_EMAIL=admin@example.com
# USER_PASSWORD=your-admin-password

# Environment
ENV_NAME=staging
DJANGO_SETTINGS_MODULE=configs.settings.staging
